#!/usr/bin/env bash
# commit-msg — Conventional Commits title linter
#
# Installed globally via: git config --global core.hooksPath ~/.github-repo/scripts/hooks
#
# Enforces: type(optional-scope): description
# Allowed types: feat fix chore docs style refactor test perf ci build revert
# Rules:
#   - Subject line must match the pattern above
#   - Subject line must not exceed 72 characters
#   - Description must not be empty
#   - No trailing period on the subject line

set -euo pipefail

COMMIT_MSG_FILE="$1"
SUBJECT=$(head -1 "$COMMIT_MSG_FILE")

# Strip comments (lines starting with #)
SUBJECT=$(echo "$SUBJECT" | sed 's/^[[:space:]]*//' | grep -v '^#' | head -1)

# Allow empty commits (e.g. --allow-empty, merge commits, fixup! etc.)
if [[ -z "$SUBJECT" ]]; then
  exit 0
fi

# Allow merge commits
if echo "$SUBJECT" | grep -qE '^Merge '; then
  exit 0
fi

# Allow revert commits generated by git
if echo "$SUBJECT" | grep -qE '^Revert "'; then
  exit 0
fi

TYPES="feat|fix|chore|docs|style|refactor|test|perf|ci|build|revert"
PATTERN="^($TYPES)(\([a-z0-9/._-]+\))?(!)?: .+"

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

fail() {
  echo ""
  echo -e "${RED}✗ Commit title rejected${NC}"
  echo -e "  Subject: ${YELLOW}${SUBJECT}${NC}"
  echo -e "  Reason:  $1"
  echo ""
  echo "  Format:  type(scope): description"
  echo "  Types:   feat fix chore docs style refactor test perf ci build revert"
  echo "  Example: feat(auth): add Google sign-in"
  echo ""
  exit 1
}

# Check pattern
if ! echo "$SUBJECT" | grep -qE "$PATTERN"; then
  fail "Must match: type(scope): description"
fi

# Check length
if [[ ${#SUBJECT} -gt 72 ]]; then
  fail "Subject line is ${#SUBJECT} chars — max is 72"
fi

# Check trailing period
if echo "$SUBJECT" | grep -qE '\.$'; then
  fail "Remove trailing period from subject line"
fi

exit 0
